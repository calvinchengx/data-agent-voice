# Copy to .env (laptop: local speech, WebSocket transport, the upstream stack on
# its emulators) or .env.prod (cloud speech, Agora transport, the upstream stack
# on real Azure). Every DAV_* key is read by the extensions and harnesses;
# *_VERSION and *_PORT keys by compose. Discipline: switching environments is
# THIS file only -- no code path knows which one it is in.

# ---- dependency pins (the BOM) ---------------------------------------------
# TEN is pinned three ways (docs/05-ten.md §7): the git tag the vendored
# extensions were copied from, the build image, and manifest-lock.json for
# the registry packages. All three move together.
TEN_VERSION=0.11.71
TEN_BUILD_IMAGE_VERSION=0.7.14
# Local TTS: an OpenAI-compatible /v1/audio/speech server with no account.
KOKORO_VERSION=v0.8.0
# Semantic turn detection is a served LLM (docs/05-ten.md §2). GPU only.
VLLM_VERSION=v0.27.1
TURN_DETECTION_MODEL=TEN-framework/TEN_Turn_Detection

# ---- host ports --------------------------------------------------------------
TEN_API_PORT=8080          # the TEN server: /start /stop /ping /graphs
TEN_WS_PORT=8765           # websocket_server: PCM in, PCM + events out
TTS_PORT=8880
TURN_DETECTION_PORT=8000
PANEL_PORT=3100

# ---- the upstream stack ------------------------------------------------------
# data-agent-service is consumed, not run, from here: this compose joins its
# network and reaches the gateway by name, exactly as any MCP client does.
# `make doctor` checks the network exists and the gateway answers.
DAS_STACK_NETWORK=data-agent-service_default
DAV_APIM_BASE=https://apim-emulator:8445
DAV_ASK_PATH=/ask
DAV_OM_MCP_PATH=/om/mcp
# The gateway's certificate is self-signed locally; real Azure is not.
DAV_TLS_INSECURE=true

# ---- identity ----------------------------------------------------------------
# The person signs in before the call (device code, via upstream identity.py)
# and every hop downstream runs as them. These name the tenant the way the
# upstream .env does, so the two files agree.
DAV_ENTRA_ISSUER=https://entra-emulator:8443/common/v2.0
DAV_ENTRA_TENANT=common
DAV_CLIENT_ID=00000000-0000-0000-0000-00000000da5c
DAV_AGENT_AUDIENCE=api://data-agent-service
DAV_USER=alice@entraemulator.dev

# ---- the host (the conversational agent) -------------------------------------
DAV_HOST_MODEL=claude-haiku-4-5
DAV_HOST_EFFORT=low
# Consumed by the anthropic_llm2 node. Never a keyvault reference here: the
# host is a model client, not a service with an identity.
ANTHROPIC_API_KEY=

# ---- speech ------------------------------------------------------------------
# local: whisper_stt_python in-process + the kokoro service below.
# A cloud provider name swaps both by property; the graph does not change.
DAV_SPEECH_PROVIDER=local
DAV_ASR_MODEL=base                 # faster-whisper size: tiny|base|small|medium|large
DAV_ASR_COMPUTE=int8               # CPU-friendly; float16 on a GPU
DAV_TTS_VOICE=af_heart
DAV_TTS_SAMPLE_RATE=24000          # what the extension actually emits (PCM16 mono)

# ---- transport ---------------------------------------------------------------
# websocket: local, no account (CI and the laptop). agora: RTC, needs the
# two keys below (prod). docs/05-ten.md §1.
DAV_TRANSPORT=websocket
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- the switches (docs/00-plan.md §10) ------------------------------------
# Each one is a measured delta on the panel. Defaults are the CI shape.
DAV_EOU_MODE=fixed                 # fixed | semantic  (semantic: make up PROFILE=semantic, GPU)
DAV_CACHE_PREFIX=false             # true once the vendored anthropic node carries a breakpoint
DAV_TTS_CHUNK=sentence             # sentence | complete
DAV_PRERENDERED_ACK=true
DAV_SPECULATIVE_DISPATCH=false     # spends tokens on guesses; a demo switch, not a default
DAV_CONFIRM_ENTITIES=true

# ---- the panel and retention ----------------------------------------------
DAV_PANEL=true
# Nothing else is retained: no audio, no transcript, no question (D7). The
# panel stores timings and event types only.
DAV_ASK_TTL_S=900
